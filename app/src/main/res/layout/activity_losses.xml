<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    tools:context=".LossesActivity">

    <!-- Estado de carga -->
    <ProgressBar
        android:id="@+id/lossesLoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/lossesLoadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/lossesLoadingIndicator"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="32dp"
        android:gravity="center"
        android:text="Calculando..."
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <!-- Contenido del resultado -->
    <ScrollView
        android:id="@+id/lossesContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título principal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Análisis de pérdidas por sombreado"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Info del sitio -->
            <TextView
                android:id="@+id/lblSite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0B0B0"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                tools:text="Sitio: lat -23.829°, lon -66.778°" />

            <TextView
                android:id="@+id/lblPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0B0B0"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                tools:text="Panel: γ=0° (N), β=24°" />

            <!-- Toggle: modo de cálculo (Geométrico / Energético) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo de cálculo"
                android:textColor="#808080"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/modeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbModeGeometric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Geométrico"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:buttonTint="#FF6B35"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbModeEnergy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Energético (PVGIS)"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:buttonTint="#FF6B35" />
            </RadioGroup>

            <!-- Tarjeta principal: pérdida anual del modo activo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center"
                android:background="#1E2128"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/lblAnnualLossTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    tools:text="Pérdida geométrica anual" />

                <TextView
                    android:id="@+id/lblAnnualLoss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF6B35"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    tools:text="7.42%" />

                <TextView
                    android:id="@+id/lblAnnualLossSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    tools:text="Pérdida moderada" />
            </LinearLayout>

            <!-- Tarjeta secundaria: kWh perdidos (solo modo energético) -->
            <LinearLayout
                android:id="@+id/energyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center"
                android:background="#1E2128"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energía perdida por sombreado"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblEnergyLost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFB84D"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    tools:text="168.4 kWh/m²/año" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FFFFFF"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/lblPoaPotential"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    tools:text="POA potencial:  2879.1 kWh/m²/año" />

                <TextView
                    android:id="@+id/lblPoaReal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp"
                    tools:text="POA real:       2710.7 kWh/m²/año" />
            </LinearLayout>

            <!-- Gráfico mensual -->
            <TextView
                android:id="@+id/lblMonthlyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pérdida por mes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/monthlyChart"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginBottom="24dp" />

            <!-- Heatmap mes x hora -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mapa de pérdida por hora del día"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.example.sunproject.HeatmapView
                android:id="@+id/heatmapView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />

            <!-- Footer con metadata del dataset (solo modo energético) -->
            <TextView
                android:id="@+id/lblDatasetFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#909090"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:text="Datos: PVGIS-ERA5 TMY (años 2005-2023) | Elevación: 4003 m" />

            <!-- Nota metodológica (texto dinámico según modo) -->
            <TextView
                android:id="@+id/lblMethodologyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#808080"
                android:textSize="11sp"
                android:textStyle="italic"
                android:layout_marginBottom="24dp"
                tools:text="Método: integración geométrica horaria (paso 15 min)..." />

            <!-- Botón volver -->
            <Button
                android:id="@+id/btnBackLosses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volver al análisis" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>